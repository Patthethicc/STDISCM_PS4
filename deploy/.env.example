# Copy to deploy/.env on EVERY VM and fill in the IPs.
# Leave a *_HOST blank (or delete the line) only when running --profile all on one machine.

# IP of each node (only the view node actually uses these)
AUTH_HOST=192.168.56.11
COURSE_HOST=192.168.56.12
GRADE_HOST=192.168.56.13
FEATURE_HOST=192.168.56.14

# Website port on the view node
VIEW_PORT=80

# gRPC deadline for every call from the gateway (ms)
GRPC_DEADLINE_MS=2000

# Token lifetime (minutes). Set to 1 to demo expiry.
JWT_TTL_MINUTES=15

# Database passwords (each DB only runs on its own node)
AUTH_DB_PASSWORD=auth
COURSE_DB_PASSWORD=course
GRADE_DB_PASSWORD=grade
FEATURE_DB_PASSWORD=feature
